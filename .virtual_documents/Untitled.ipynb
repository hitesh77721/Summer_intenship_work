text = "Hello!!! 😊😊 My name is Hitesh. I'm learning NLP in 2026. Visit https://google.com"


# lowering
text = text.lower()
text


# removing url

import re 
text = re.sub(r'https?://\S+|www\.\S+', '', text)
text





# expand contraction 

import contractions
text = contractions.fix(text)
text


# removing punctuation 

import string
# string.punctuation
table = str.maketrans('', '', string.punctuation)
text = text.translate(table)
text


# remove numbers 
# text = re.sub(r'\d+', '', text)
# text


from nltk.tokenize import word_tokenize

import nltk
nltk.download('punkt')

tokens = word_tokenize(text)


tokens
# text


import nltk

nltk.download('stopwords')


from nltk.corpus import stopwords

stop_words = set(stopwords.words('english'))
stop_words


filtered_tokens = []

for word in tokens:
    if word not in stop_words:
        filtered_tokens.append(word)


filtered_tokens


from nltk.stem import PorterStemmer 
from nltk.stem import WordNetLemmatizer

ps = PorterStemmer()
lemmatizer = WordNetLemmatizer()

filtered_tokens += ["studying"]
stemmed_words = []
lemmatizer_words = []
for word in filtered_tokens:
    stemmed_words.append(ps.stem(word))
    lemmatizer_words.append(lemmatizer.lemmatize(word, pos="v"))



print(lemmatizer_words)
filtered_tokens, stemmed_words














